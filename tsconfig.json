        "target": "ESNext",
        "module": "commonjs",
        "moduleResolution": "node",
        "types": [
            "node",
            "@playwright/test"
        ],
        "esModuleInterop": true,
        "resolveJsonModule": true
    },
    "include": [
        "playwright.config.ts",
        "tests/**/*.ts"
    ]
}